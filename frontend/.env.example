# Variables del frontend Next.js (full-stack). Copiar a .env.local y completar.
# Nunca subir el .env.local real.

# PostgreSQL + pgvector (misma que docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acelerador

# LLM (Arquitecto RAG). Claude vía LangChain (@langchain/anthropic).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# GitHub (pipeline de ingesta / revalidación de ETags)
GITHUB_TOKEN=

# Servicios de apoyo (opcionales en dev)
MEILISEARCH_HOST=http://localhost:7700
KEYCLOAK_URL=http://localhost:8080
